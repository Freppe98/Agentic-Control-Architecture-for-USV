# Operator Station — local configuration template.
#
# Copy to .env (install_operator.ps1 does this automatically on first run) and edit as
# needed. .env is git-ignored and never committed; this .example file is the documented,
# secret-free reference. There are NO secrets here — the Operator Station holds no
# credentials or API keys; Scout is told where to post at runtime (see RUNBOOK.md), so
# nothing about the vehicle lives in this file.
#
# Only run_operator_backend.ps1 reads this file, and only for the two values below. If
# .env is absent, the script falls back to these same defaults, so an unconfigured
# checkout behaves exactly as before.

# TCP port the backend listens on. The UI and Scout's status posts both target this port
# (default 8210). Change it here if 8210 is already in use on this PC.
OPERATOR_BACKEND_PORT=8210

# Interface to bind. 0.0.0.0 = all interfaces, which is required so Scout's Local Agent
# can reach the backend over the LAN (not just localhost). Set to 127.0.0.1 to restrict
# to this machine only (e.g. for a UI-only dev session with no vehicle).
OPERATOR_BACKEND_HOST=0.0.0.0
