# Operator Station — ignore local, generated and machine-specific files.
# (The repo-root .gitignore also covers Scout reference material and Python bytecode;
#  this file scopes the setup/bootstrap artefacts to the operator-scripts subtree.)

# Python virtual environment created by install_operator.ps1
.venv/

# Node dependencies restored by `npm ci` (frontend/test tooling)
node_modules/

# Local configuration copied from .env.example — never commit (may hold machine-specific
# port/host); the committed template is .env.example
.env

# Runtime artifacts from hidden launcher
.operator.pid
logs/

# Survey draft store written at runtime by the Plan page (PLANNING_DRAFTS_DIR in main.py).
# Operator-local mission state, not source — each station keeps its own.
planning_drafts/

# Durable mission store: the approved original-mission records + the active mission per
# vehicle (MISSION_STORE_DIR in main.py). Operator-local operational state, not source.
runtime_data/

# Python bytecode / caches
__pycache__/
*.pyc
.pytest_cache/
